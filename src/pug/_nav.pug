-
  const banners = [
    {
      id: 'cladd',
      href: 'https://cladd.io/',
      img: '/i/home-projects/cladd.svg',
      prefix: 'Meet our new project:',
      text: 'Cladd — A React UI kit for building actual apps',
    },
    {
      id: 'paneflow',
      href: 'https://paneflow.com/',
      img: '/i/home-projects/paneflow.svg',
      prefix: 'All-new',
      text: 'PaneFlow v2 is here',
    },
    {
      id: 'swiper-studio',
      href: 'https://studio.swiperjs.com/',
      img: '/i/home-projects/swiper-studio.svg',
      prefix: 'All-new',
      text: 'Swiper Studio v2 is here',
    },
    {
      id: 't0ggles',
      href: 'https://t0ggles.com/',
      img: '/i/home-projects/t0ggles.svg',
      prefix: 't0ggles —',
      text: 'now with a free plan!',
    },
    {
      id: 'startpagehq',
      href: 'https://startpagehq.com/',
      img: '/i/home-projects/startpagehq.svg',
      prefix: 'Start Page HQ —',
      text: 'now with a free plan!',
    },
  ];
.sphq-banner
  each banner in banners
    a(href=banner.href target="_blank" data-banner=banner.id)
      img(src=banner.img alt="")
      | #{banner.prefix}
      span #{banner.text}
  script.
    (function () {
      var links = document.querySelectorAll('.sphq-banner a');
      var link = links[Math.floor(Math.random() * links.length)];
      if (link) link.classList.add('sphq-banner-active');
    })();

nav
  .nav-left
    a(href="/").nav-logo
      img(src="/i/logo.svg")
      img(src="/i/logo-text-white.svg")
      span v#{release.version}
  .nav-right
    .nav-searchbar
      input(type="search", placeholder="Search")
      span.disable-search
    ul.nav-menu
      li
        a(href="/docs/") Docs
        ul
          li
            a(href="/docs/introduction.html") Getting Started
          li.divider
          li
            a(href="/docs/") Framework7 Core / API
          li
            a(href="/vue/") Framework7 Vue
          li
            a(href="/react/") Framework7 React
          li
            a(href="/svelte/") Framework7 Svelte
          li.divider
          li
            a(href="/cli/") Framework7 CLI
          li
            a(href="/mcp/") Framework7 MCP Server
          li
            a(href="/icons/") Framework7 Icons
          li
            a(href="/docs/dom7.html") Dom7
          li.divider
          li
            a(href="/release-notes/") Release Notes
          li.divider
          li
            a(href="https://v8.framework7.io/" target="_blank") Framework7 v8
      li
        a Resources
        ul
          li
            a(href="https://forum.framework7.io" target="_blank") Community Forum
          li
            a(href="/tutorials/") Tutorials
          li
            a(href="/templates/") Templates
          li
            a(href="/plugins/") Plugins
          li
            a(href="/showcase/") Apps Showcase
      li
        a(href="https://blog.framework7.io" target="_blank") Blog
      li
        include _github-buttons
    .nav-menu-backdrop
    .nav-toggle
      span
      span
      span

// User Experienced newsletter — auto popover (wide screens)
.uxd-popover(role="dialog" aria-label="User Experienced newsletter")
  .uxd-popover-header
    button.uxd-popover-close(type="button" aria-label="Close")
      svg(width="10" height="10" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg")
        path(d="M3 3L13 13M13 3L3 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round")
  .uxd-popover-body
    a.uxd-popover-logo(href="https://uxed.substack.com" target="_blank" rel="noopener")
      img(src="/i/uxd-logo-red.png" alt="User Experienced")
    .uxd-popover-title Subscribe to the User Experienced
    .uxd-popover-text Subscribe for weekly web, app, and logo design inspiration.
  .uxd-popover-embed
    iframe(data-src="https://uxed.substack.com/embed" frameborder="0" scrolling="no" title="Subscribe to User Experienced")
  .uxd-popover-footer
    span co-curated by
    img(src="/i/logo.svg" alt="Framework7")
    span Framework7 authors
